# ---------------------------------------------------------------------------
# SECRETS - never commit these
# ---------------------------------------------------------------------------
# The Android signing key and its password. Anyone holding these can publish an
# update that Android will accept as a genuine update to this app. Losing them
# is almost as bad: you can no longer ship an upgrade to anyone who already
# installed it, they would have to uninstall first. Back both up somewhere
# private and off this machine.
android/android.keystore
android/*.keystore
android/*.jks
android/signing-key.env
*.keystore
*.jks

.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# MapLibre's worker is copied into public/ by scripts/sync-maplibre-worker.mjs
# on install and prebuild, so it is regenerated rather than committed.
public/maplibre/

# ---------------------------------------------------------------------------
# Android build artefacts
# ---------------------------------------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/*.iml
# The generated wrapper jar is large and recreated by `bubblewrap update`.
android/gradle/wrapper/gradle-wrapper.jar

# The signed release APK is committed deliberately, under public/app/, so the
# download link on /install works and the repo carries a ready build.
android/app/build/outputs/

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
.npm/
.eslintcache
coverage/
*.tmp
probe.mjs
r.mjs
t.mjs

# ---------------------------------------------------------------------------
# Generated by the Next.js dev server for AI tooling; regenerated on demand.
# ---------------------------------------------------------------------------
CLAUDE.md
AGENTS.md
public/app/*.idsig
